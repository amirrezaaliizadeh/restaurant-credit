# Copy to .env and edit. Never commit .env.
PORT=3000
STAFF_PIN=change-me
RESTAURANT_NAME=Trattoria Bella

# dry-run (prints messages to the console) | twilio-sms | twilio-whatsapp | whatsapp-cloud
MESSAGE_PROVIDER=dry-run

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# For twilio-sms: your Twilio number or alphanumeric sender (e.g. +39xxxxxxxxxx)
TWILIO_SMS_FROM=

# For twilio-whatsapp: your WhatsApp sender number (without "whatsapp:")
TWILIO_WHATSAPP_FROM=
# Approved Meta template (Content SID, starts with HX). Variables: {{1}} first name, {{2}} amount, {{3}} balance
TWILIO_WHATSAPP_CONTENT_SID=

# --- Cheapest WhatsApp: Meta Cloud API directly (MESSAGE_PROVIDER=whatsapp-cloud) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=credit_update
WHATSAPP_TEMPLATE_LANG=en
# Webhook (customers messaging you -> free 24h window). Callback URL: https://YOUR-DOMAIN/webhook/whatsapp
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-string
WHATSAPP_APP_SECRET=

# --- Message cost control ---
# What to send when the customer has NOT messaged you in the last 24h (those messages cost a small fee):
#   daily   = one summary message per customer per day
#   charges = only when credit is deducted (default)
#   low     = top-ups, and deductions that leave less than LOW_BALANCE_EUR
#   every   = one message per transaction
# If the customer messaged you in the last 24h, every change is sent immediately and for free.
NOTIFY_MODE=charges
NOTIFY_DAILY_HOUR=21
LOW_BALANCE_EUR=20
