# Copy this file to .env and fill in your own values. Never commit .env.
RESTAURANT_NAME=Our Restaurant
STAFF_PIN=change-me-to-a-strong-pin
PORT=3000
# DB_PATH=./data.db

# dry-run | twilio-sms | twilio-whatsapp | whatsapp-cloud
MESSAGE_PROVIDER=dry-run
# daily | instant
NOTIFY_MODE=daily
NOTIFY_DAILY_HOUR=21
LOW_BALANCE_EUR=10

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=credit_update
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
